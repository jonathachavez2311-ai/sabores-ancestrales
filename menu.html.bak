<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sabores Ancestrales | Menú</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <header>
    <div class="container navbar">
      <div class="logo">
        <img src="imagenes/Logo.jpg" alt="Logo Sabores Ancestrales">
        <span>Sabores Ancestrales</span>
      </div>
      <button id="menu-toggle">☰</button>
      <ul id="nav-links" class="nav-links">
        <li><a href="index.html">Inicio</a></li>
        <li><a href="informacion.html">Información</a></li>
        <li><a href="menu.html" class="active">Platillos</a></li>
        <li><a href="reservas.html">Reservas</a></li>
        <li><a href="valoracion.html">Valoración</a></li>
        <li><a href="opiniones.html">Opiniones</a></li>
      </ul>
    </div>
  </header>

  <section>
    <div class="container">
      <h2>Nuestros Platillos</h2>
      <p class="lead">Explora nuestras categorías y descubre los sabores que preparamos con pasión y tradición.</p>

      <div class="menu-categories">
        <button class="category-btn active" data-category="entradas">Entradas</button>
        <button class="category-btn" data-category="platos">Platos Principales</button>
        <button class="category-btn" data-category="postres">Postres</button>
        <button class="category-btn" data-category="bebidas">Bebidas</button>
      </div>

      <div class="menu-grid" id="menu-items"></div>

      <div class="pedido" id="pedido">
        <h3>Resumen del Pedido</h3>
        <ul id="pedido-list"></ul>
        <p><strong>Total:</strong> $<span id="total">0.00</span></p>

        <label for="pago">Método de pago:</label>
        <select id="pago">
          <option value="efectivo">Efectivo</option>
          <option value="tarjeta">Tarjeta</option>
        </select>

        <button class="btn" id="finalizar">Finalizar Pedido</button>

        <div class="ticket" id="ticket" style="display:none;"></div>
      </div>
    </div>
  </section>

  <footer>
    <p>&copy; 2025 Sabores Ancestrales. Todos los derechos reservados.</p>
  </footer>

  <script src="js/main.js"></script>
  <script>
    const categoryButtons = document.querySelectorAll('.category-btn');
    const menuItemsContainer = document.getElementById('menu-items');
    const pedidoList = document.getElementById('pedido-list');
    const totalEl = document.getElementById('total');
    const ticketEl = document.getElementById('ticket');

    let total = 0;
    const pedido = [];

    // He convertido los precios a córdobas nicaragüenses usando 1 USD = 36 NIO
    // y añadí la propiedad `currency: 'C$'` para mostrar la moneda.
    const menuData = {
      'entradas': [
        { name: 'Bruschetta', description: 'Pan crujiente con tomate confitado, aceite de oliva y albahaca fresca. Perfecta para compartir.', price: 324.00, currency: 'C$', image: 'imagenes/entrada1.png' },
        { name: 'Ceviche Tropical', description: 'Filetes de pescado fresco curados en jugo de limón, con cebolla morada, cilantro y toque de ají dulce.', price: 396.00, currency: 'C$', image: 'imagenes/entrada2.png' },
        { name: 'Ensalada Caprese', description: 'Mozzarella cremosa con tomate heirloom, reducción de balsámico y hojas de albahaca.', price: 360.00, currency: 'C$', image: 'imagenes/entrada3.png' }
      ],
      'platos': [
        { name: 'Risotto de Champiñones', description: 'Arroz cremoso cocido a fuego lento con setas silvestres y parmesano rallado.', price: 612.00, currency: 'C$', image: 'imagenes/Risotto de Champiñones.png' },
        { name: 'Salmón a la Parrilla', description: 'Salmón sellado con corte perfecto, acompañado de verduras asadas y reducción cítrica.', price: 684.00, currency: 'C$', image: 'imagenes/Salmón a la Parrilla.png' },
        { name: 'Pasta Carbonara', description: 'Pasta al dente con salsa cremosa de huevo, pancetta crocante y un toque de pimienta negra.', price: 540.00, currency: 'C$', image: 'imagenes/Pasta Carbonara.png' }
      ],
      'postres': [
        { name: 'Tiramisú', description: 'Capas de bizcocho empapado en café, crema de mascarpone y cacao espolvoreado.', price: 288.00, currency: 'C$', image: 'imagenes/postre1.png' },
        { name: 'Cheesecake de Fresa', description: 'Base crujiente y crema de queso suave con coulis de fresa natural.', price: 324.00, currency: 'C$', image: 'imagenes/postre2.png' },
        { name: 'Brownie con Helado', description: 'Brownie tibio de chocolate intenso servido con helado de vainilla y salsa de caramelo.', price: 360.00, currency: 'C$', image: 'imagenes/postre3.png' }
      ],
      'bebidas': [
        { name: 'Vino Tinto de la Casa', description: 'Copa de nuestro tinto seleccionado por el sommelier.', price: 252.00, currency: 'C$', image: 'imagenes/Vino Tinto de la Casa.png' },
        { name: 'Cóctel Margarita', description: 'Mezcla clásica de tequila, triple sec y jugo de limón con sal en el borde.', price: 360.00, currency: 'C$', image: 'imagenes/limon.png' },
        { name: 'Café Espresso', description: 'Café espresso italiano, corto e intenso, servido en taza pequeña.', price: 144.00, currency: 'C$', image: 'imagenes/Café espresso italiano.png' }
 ],
        'cervezas': [
        { name: 'Cerveza Toña', description: 'Cerveza lager nicaragüense, suave y refrescante. La más popular del país.', price: 180.00, currency: 'C$', image: 'imagenes/cervezatona.png' },
        { name: 'Cerveza Victoria', description: 'Cerveza nicaragüense con más de 90 años de tradición. Sabor único y característico.', price: 190.00, currency: 'C$', image: 'imagenes/victoria.png' },
        { name: 'Cerveza Premium', description: 'Cerveza premium nicaragüense con sabor robusto y cuerpo completo.', price: 200.00, currency: 'C$', image: 'imagenes/premiun.png' },
        { name: 'Cerveza Toña Light', description: 'Versión ligera de la clásica Toña, con menos calorías pero el mismo sabor refrescante.', price: 180.00, currency: 'C$', image: 'imagenes/lignt.png' },
        { name: 'Cerveza Victoria Frost', description: 'Cerveza refrescante con un toque cítrico, perfecta para el clima tropical.', price: 195.00, currency: 'C$', image: 'imagenes/frost.png' }
      ],
    };

    function loadMenuItems(category) {
      menuItemsContainer.innerHTML = '';
      if (!menuData[category] || !Array.isArray(menuData[category])) {
        console.warn('Categoría no encontrada:', category);
        return;
      }
      menuData[category].forEach(item => {
        // Seguridad: asegurar que price sea número
        item.price = Number(item.price) || 0;
          const div = document.createElement('div');
          div.className = 'menu-item';
          const priceDisplay = item.currency ? `${item.currency}${item.price.toFixed(2)}` : `$${item.price.toFixed(2)}`;
        // Añadir fallback visual si la imagen no carga
        const imgSrc = item.image || 'imagenes/descarga.png';
        div.innerHTML = `
          <img src="${imgSrc}" alt="${item.name}" loading="lazy" onerror="this.onerror=null;this.src='imagenes/descarga.png'">
            <div class="content">
              <h4>${item.name} <span class="price">${priceDisplay}</span></h4>
              <p>${item.description}</p>
              <button class="add-btn">Agregar</button>
            </div>
          `;
        div.querySelector('.add-btn').addEventListener('click', () => agregarAlPedido(item));
        menuItemsContainer.appendChild(div);
      });
    }

    function agregarAlPedido(item) {
      pedido.push(item);
      total += item.price;
      actualizarPedido();
    }

    function actualizarPedido() {
      pedidoList.innerHTML = '';
      pedido.forEach(p => {
        const li = document.createElement('li');
        const currency = p.currency ? p.currency : 'C$';
        li.textContent = `${p.name} - ${currency}${p.price.toFixed(2)}`;
        pedidoList.appendChild(li);
      });
      // Mostrar la moneda usando el currency del primer item del pedido si existe
      const displayCurrency = pedido.length > 0 && pedido[0].currency ? pedido[0].currency : 'C$';
      // Si el pedido está vacío, mostrar C$0.00
      totalEl.textContent = `${displayCurrency}${(pedido.length > 0 ? total : 0).toFixed(2)}`;
    }

    document.getElementById('finalizar').addEventListener('click', () => {
      if (pedido.length === 0) {
        alert('Agrega al menos un producto al pedido.');
        return;
      }

      const pago = document.getElementById('pago').value;
      const id = Math.floor(Math.random() * 1000000);
      const pedidoTexto = pedido.map(p => `${p.name} - $${p.price.toFixed(2)}`).join(', ');

      // Guardar pedido en la base de datos vía PHP
      fetch("php/guardar_pedido.php", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `pedido=${encodeURIComponent(pedidoTexto)}&total=${total.toFixed(2)}&pago=${pago}`
      })
      .then(res => res.text())
      .then(data => {
        alert(data);
      });

      // Mostrar ticket
      ticketEl.style.display = 'block';
      const displayCurrency = pedido.length > 0 && pedido[0].currency ? pedido[0].currency : 'C$';
      ticketEl.innerHTML = `
        <h4>✅ Pedido confirmado</h4>
        <p><strong>ID Pedido:</strong> ${id}</p>
        <ul>${pedido.map(p => `<li>${p.name} - ${p.currency ? p.currency : 'C$'}${p.price.toFixed(2)}</li>`).join('')}</ul>
        <p><strong>Total:</strong> ${displayCurrency}${total.toFixed(2)}</p>
        <p><strong>Método de pago:</strong> ${pago}</p>
        <p>¡Gracias por tu compra en <strong>Sabores Ancestrales</strong>!</p>
      `;

      pedido.length = 0;
      total = 0;
      actualizarPedido();
    });

    categoryButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        loadMenuItems(btn.dataset.category);
      });
    });

    loadMenuItems('entradas');
  </script>
</body>
</html>
